# Copy to .env before the first run:  cp .env.example .env
# Every value here is a placeholder. Never commit a real secret.

# --- PostgreSQL (consumed by docker-compose.yml) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=product_content_studio
# Host port for the container. Change it if you already run Postgres on 5432,
# and update the port in DATABASE_URL to match.
POSTGRES_PORT=5432

# --- Prisma ---
# Host is localhost when the app runs via `npm run dev` against the Postgres container.
# Inside `docker compose --profile full`, the host is the service name `postgres` instead.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/product_content_studio?schema=public

# --- Admin session cookie signing key ---
# Generate your own before running anything you care about:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-with-a-32-byte-random-hex-string

# --- The single admin account created by `npm run db:seed` ---
# The seed hashes ADMIN_PASSWORD at run time; no plaintext or hash is ever committed.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123!
